# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Every value below has a sensible default in jobagent/config.py; you only need
# to set DATABASE_URL (if not using the defaults) and one LLM API key.

# ─── Database ────────────────────────────────────────────────────────────
# Docker path (docker compose up -d db) listens on 5432 — the default below.
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
# No Docker? scripts/pg_local.sh runs Homebrew Postgres on 5433 instead — then use:
# DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5433/jobagent

# ─── LLM provider (Stage-B scoring + resume tailoring) ───────────────────
# One of: gemini | groq | anthropic. Set the matching API key below.
LLM_PROVIDER=gemini

# Gemini (a generous free tier makes this the easiest to start with):
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=your-key-here

# Groq (fast, free tier):
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your-key-here

# Anthropic:
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=your-key-here

# ─── Cost guards (per scoring/tailoring run) ─────────────────────────────
MAX_LLM_CALLS_PER_RUN=70
MAX_SPEND_USD_PER_RUN=0.50

# ─── Scoring knobs ───────────────────────────────────────────────────────
SCORE_THRESHOLD=65            # match_score (0-100) needed to reach the queue
TOP_N_LLM=200                 # how many top cheap-scored jobs get the LLM rubric
MAX_PER_COMPANY_IN_WINDOW=5   # diversity: cap per company in the LLM window
STACK_MATCH_THRESHOLD=0.60    # semantic stack-gate similarity threshold
STACK_GATE_MIN_MISSING=3      # min missing required skills to gate a job out
MAX_AGE_DAYS=90               # ignore postings older than this at ingest
STALE_MODE=keep               # keep | filter stale postings

# ─── Resume tailoring ────────────────────────────────────────────────────
TAILOR_MAX_BULLETS=8          # cap (never a quota); resume is never padded
TAILOR_MIN_RELEVANCE=0.45     # a fact must clear this select-score to appear
TAILOR_MIN_BULLETS=3          # floor before a resume is flagged a "thin match"

# ─── Boards ──────────────────────────────────────────────────────────────
ENABLE_WORKABLE=false         # Workable is rate-limit-prone; off by default
